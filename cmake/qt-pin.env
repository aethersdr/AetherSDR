# The binary Qt pin, in one place (#5487).
#
# Every release artifact and every CI leg installs exactly this Qt, and
# scripts/setup/setup-qt.sh installs it for source builders. The workflows and
# the CI Dockerfile still spell the values out themselves — they cannot source
# a file before their own `env:` blocks are evaluated — so
# tools/check_qt_pin.py fails Static Checks the moment any of them disagrees
# with this file. Change the pin HERE first, then update the sites it names.
#
# Format: KEY=value, one per line, no spaces around `=`. Read by bash (sourced),
# CMake (cmake/AetherQtPin.cmake) and Python (tools/check_qt_pin.py). Values
# with spaces are double-quoted.

QT_VERSION=6.12.0

# Qt republishes the same version string (RC and final both report 6.12.0).
# This is the <Version> suffix in the repository's Updates.xml; setup-qt.sh
# refuses to install if the repository now serves a different build.
QT_PACKAGE_REVISION=202609280346

# The oldest Qt a source build accepts (CMakeLists.txt's find_package and its
# below-floor check, MAJOR.MINOR). Stated separately from QT_VERSION on purpose:
# a pin bump must never raise the floor as a side effect — that is a decision,
# made here. tools/check_qt_pin.py requires it to be <= QT_VERSION.
QT_SOURCE_FLOOR=6.12

AQTINSTALL_VERSION=3.3.0
# Windows only: PyPI aqtinstall 3.3.0 cannot read the 6.11+ per-arch Windows
# repository layout (aqtinstall#959, fixed by unreleased #1000).
AQTINSTALL_GIT_REF=076e1659807d0b362a3ed684d54c2e9c775eb9c7
PY7ZR_VERSION=1.1.3

QT_MODULES="qtmultimedia qtwebsockets qtserialport qtshadertools"

# Measured on the official binaries of the pinned build (readelf -V across
# qtbase, qtwayland, qtsvg and the four modules above; llvm-otool -l on the
# macOS frameworks). These are properties of Qt's packages, not of AetherSDR,
# and change only when the pin does.
QT_MIN_GLIBC_X86_64=2.34
QT_MIN_GLIBC_AARCH64=2.38
QT_MIN_MACOS=14.4
QT_MIN_XCODE=16
# Qt's static Qt6EntryPoint.lib (linked into every Windows GUI app) is built by
# MSVC 14.44 (compiler build 35227 in its @comp.id), and an MSVC linker must be
# at least as new as the newest compiler behind any input.
QT_MIN_VS=17.14
