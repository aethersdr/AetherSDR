new file mode 100644
index 0000000..93d7b9c
--- /dev/null
+++ b/src/core/RfkitConnection.h
@@ -0,0 +1,140 @@
+#pragma once
+
+#include <QHash>
+#include <QNetworkAccessManager>
+#include <QNetworkReply>
+#include <QObject>
+#include <QPointer>
+#include <QQueue>
+#include <QSet>
+#include <QString>
+#include <QTimer>
+#include <QUrl>
+
+#include "RfkitProtocol.h"
+
+namespace AetherSDR {
+
+// Peripheral transport for an RF-KIT amplifier.
+//
+// A standalone Ethernet device with no FlexRadio awareness at all, so this is
+// a peripheral(rfkit) accessory alongside AcomConnection/SpeConnection/
+// VkampConnection/Kpa1500Connection, not an IRadioBackend implementor. See
+// docs/architecture/rfkit-amplifier-design.md.
+//
+// The device speaks a REST API over HTTP/1.1 (RfkitProtocol.h), not a
+// streaming socket protocol, and it never pushes: every reading below arrives
+// because this class asked for it. So the shape differs from the socket-based
+// peripherals in two ways:
+//
+//  * "Connected" is not a TCP state. connectNetwork() issues GET /info, and
+//    the link counts as up only when that returns an RF-KIT-shaped document.
+//    It counts as down again after kMaxConsecutiveFailures transport failures
+//    in a row, so one dropped request does not flicker the applet.
+//  * Requests are strictly serialized, one in flight at a time. The device is
+//    a small embedded controller, and a command that has to queue behind a
+//    full poll round on a congested link is better than a burst that makes it
+//    drop requests. Commands jump the queue; polls are only enqueued when the
+//    queue is empty, so a slow device lowers the poll rate instead of
+//    building a backlog.
+//
+// Like every peripheral here, control writes never latch an optimistic value:
+// the device is the authority on its own state, and the applet repaints from
+// the reply (constitution Principle II).
+class RfkitConnection : public QObject {
+    Q_OBJECT
+
+public:
+    explicit RfkitConnection(QObject* parent = nullptr);
+    ~RfkitConnection() override;
+
+    bool isConnected() const { return m_connected; }
+    QString description() const;  // "192.168.1.60:8080", for status display
+
+    void connectNetwork(const QString& host, quint16 port = Rfkit::kDefaultPort);
+    void disconnect();
+    void setAutoReconnect(bool on) { m_autoReconnect = on; }
+
+    // Control (host -> amp). Each is a no-op, logged, when not connected.
+    void setOperate(bool operate);
+    // An antenna outside the API document's range for its type is refused,
+    // logged, and never sent.
+    void selectAntenna(const Rfkit::Antenna& antenna);
+    // POST /error/reset. Clears the amplifier's error state; the device answers
+    // 409 while the function is disabled, which is logged.
+    void resetError();
+
+signals:
+    void connected();
+    void disconnected();
+    void connectionFailed(const QString& errorString);
+    // Full current snapshot, emitted when a reply actually changed something.
+    void statusUpdated(const AetherSDR::Rfkit::Status& status);
+
+private:
+    struct Request {
+        enum class Method { Get, Put, Post };
+        Method method{Method::Get};
+        QString path;
+        QByteArray body;
+        bool probe{false};  // the connect handshake (GET /info)
+    };
+
+    void enqueue(const Request& request, bool front = false);
+    void pump();
+    void onReplyFinished(QNetworkReply* reply, const Request& request, int epoch);
+    // Returns true when the reply changed the snapshot.
+    bool applyReply(const Request& request, const QByteArray& body);
+    void onProbeSucceeded();
+    void onTransportFailure(const QString& errorString, const Request& request);
+    void onTransportDown(const QString& errorString);
+    void poll();
+    void enqueueFullRefresh();
+    void armReconnect();
+    void resetSession();
+
+    QNetworkAccessManager m_nam;
+    QUrl m_baseUrl;
+    QPointer<QNetworkReply> m_reply;
+    QQueue<Request> m_queue;
+    bool m_inFlight{false};
+
+    Rfkit::Status m_status;
+    // The last body seen per path, so an unchanged slow reply does not
+    // re-emit statusUpdated().
+    QHash<QString, QByteArray> m_lastBody;
+    // Paths already warned about for an unparseable 2xx body, so a firmware
+    // that answers with an unexpected shape logs once per connection rather
+    // than four times a second.
+    QSet<QString> m_warnedPaths;
+
+    QString m_lastHost;
+    quint16 m_lastPort{Rfkit::kDefaultPort};
+
+    bool m_connected{false};
+    bool m_autoReconnect{false};
+    bool m_deliberateDisconnect{false};
+
+    // Bumped on every connect/disconnect. A reply carries the epoch it was
+    // issued under, and one from a previous session is discarded unread: a
+    // late answer from attempt N must never touch attempt N+1 (#2380).
+    int m_epoch{0};
+    int m_consecutiveFailures{0};
+    static constexpr int kMaxConsecutiveFailures = 3;
+
+    // Per-request transfer timeout. Also bounds the connect handshake, so an
+    // unreachable address reports failure here rather than after the OS TCP
+    // connect timeout (~21s on Windows).
+    static constexpr int kRequestTimeoutMs = 4000;
+
+    QTimer m_reconnectTimer;
+    static constexpr int kReconnectIntervalMs = 5000;
+
+    // /power and /data every tick; one of the slower, configuration-style
+    // endpoints per tick in rotation (see poll()).
+    QTimer m_pollTimer;
+    static constexpr int kPollIntervalMs = 250;
+    int m_slowPollIndex{0};
+};
+
+}  // namespace AetherSDR
diff --git a/src/core/RfkitProtocol.cpp b/src/core/RfkitProtocol.cpp
new file mode 100644
index 0000000..4ef578b
--- /dev/null
+++ b/src/core/RfkitProtocol.cpp
@@ -0,0 +1,477 @@
+#include "RfkitProtocol.h"
+
+#include <QJsonArray>
+#include <QJsonDocument>
+#include <QJsonObject>
+#include <QJsonParseError>
+#include <QJsonValue>
+
+#include <cmath>
+#include <limits>
+
+namespace AetherSDR {
+namespace Rfkit {
+
+namespace {
+
+std::optional<QJsonObject> parseObject(const QByteArray& body)
+{
+    if (body.isEmpty() || body.size() > kMaxBodyBytes) {
+        return std::nullopt;
+    }
+    QJsonParseError error;
+    const QJsonDocument doc = QJsonDocument::fromJson(body, &error);
+    if (error.error != QJsonParseError::NoError || !doc.isObject()) {
+        return std::nullopt;
+    }
+    return doc.object();
+}
+
+bool asInt(const QJsonValue& v, int& out)
+{
+    if (!v.isDouble()) {
+        return false;
+    }
+    const double d = v.toDouble();
+    if (!std::isfinite(d) || d < static_cast<double>(std::numeric_limits<int>::min())
+        || d > static_cast<double>(std::numeric_limits<int>::max())) {
+        return false;
+    }
+    out = static_cast<int>(std::lround(d));
+    return true;
+}
+
+bool asFloat(const QJsonValue& v, float& out)
+{
+    if (!v.isDouble()) {
+        return false;
+    }
+    const double d = v.toDouble();
+    // A float that overflows to infinity would drive a gauge to nonsense.
+    if (!std::isfinite(d) || std::fabs(d) > 1.0e9) {
+        return false;
+    }
+    out = static_cast<float>(d);
+    return true;
+}
+
+QString stringOr(const QJsonValue& v, const QString& fallback = QString())
+{
+    return v.isString() ? v.toString() : fallback;
+}
+
+// {"value": <int>, "unit": "..."}. The value is required; the unit is
+// descriptive and defaults to empty.
+std::optional<IntValue> parseIntValue(const QJsonValue& v)
+{
+    if (!v.isObject()) {
+        return std::nullopt;
+    }
+    const QJsonObject o = v.toObject();
+    IntValue out;
+    if (!asInt(o.value(QLatin1String("value")), out.value)) {
+        return std::nullopt;
+    }
+    out.unit = stringOr(o.value(QLatin1String("unit")));
+    return out;
+}
+
+std::optional<FloatValue> parseFloatValue(const QJsonValue& v)
+{
+    if (!v.isObject()) {
+        return std::nullopt;
+    }
+    const QJsonObject o = v.toObject();
+    FloatValue out;
+    if (!asFloat(o.value(QLatin1String("value")), out.value)) {
+        return std::nullopt;
+    }
+    out.unit = stringOr(o.value(QLatin1String("unit")));
+    return out;
+}
+
+// max_value is the device's own full-scale; absent or unusable means 0, which
+// the applet reads as "not reported" and falls back to a default scale.
+std::optional<IntWithMax> parseIntWithMax(const QJsonValue& v)
+{
+    if (!v.isObject()) {
+        return std::nullopt;
+    }
+    const QJsonObject o = v.toObject();
+    IntWithMax out;
+    if (!asInt(o.value(QLatin1String("value")), out.value)) {
+        return std::nullopt;
+    }
+    int max = 0;
+    if (asInt(o.value(QLatin1String("max_value")), max) && max > 0) {
+        out.maxValue = max;
+    }
+    out.unit = stringOr(o.value(QLatin1String("unit")));
+    return out;
+}
+
+std::optional<FloatWithMax> parseFloatWithMax(const QJsonValue& v)
+{
+    if (!v.isObject()) {
+        return std::nullopt;
+    }
+    const QJsonObject o = v.toObject();
+    FloatWithMax out;
+    if (!asFloat(o.value(QLatin1String("value")), out.value)) {
+        return std::nullopt;
+    }
+    float max = 0.0f;
+    if (asFloat(o.value(QLatin1String("max_value")), max) && max > 0.0f) {
+        out.maxValue = max;
+    }
+    out.unit = stringOr(o.value(QLatin1String("unit")));
+    return out;
+}
+
+std::optional<Antenna> antennaFromObject(const QJsonObject& o)
+{
+    const QString type = o.value(QLatin1String("type")).toString();
+    int number = 0;
+    if (!asInt(o.value(QLatin1String("number")), number)) {
+        return std::nullopt;
+    }
+    Antenna antenna;
+    if (type == QLatin1String("INTERNAL")) {
+        antenna.type = AntennaType::Internal;
+        if (number < kMinInternalAntenna || number > kMaxInternalAntenna) {
+            return std::nullopt;
+        }
+    } else if (type == QLatin1String("EXTERNAL")) {
+        antenna.type = AntennaType::External;
+        if (number < kMinExternalAntenna || number > kMaxExternalAntenna) {
+            return std::nullopt;
+        }
+    } else {
+        return std::nullopt;
+    }
+    antenna.number = number;
+    return antenna;
+}
+
+bool antennaInRange(const Antenna& a)
+{
+    if (a.type == AntennaType::Internal) {
+        return a.number >= kMinInternalAntenna && a.number <= kMaxInternalAntenna;
+    }
+    return a.number >= kMinExternalAntenna && a.number <= kMaxExternalAntenna;
+}
+
+TunerMode tunerModeFromValue(const QJsonValue& v)
+{
+    // The API document's enum lists the literal `false` beside the names (a
+    // generator artifact for a YAML "off"); accept it as a boolean or a string.
+    if (v.isBool()) {
+        return v.toBool() ? TunerMode::Unknown : TunerMode::Off;
+    }
+    const QString s = v.toString();
+    if (s == QLatin1String("BYPASS"))      { return TunerMode::Bypass; }
+    if (s == QLatin1String("MANUAL"))      { return TunerMode::Manual; }
+    if (s == QLatin1String("AUTO_TUNING")) { return TunerMode::AutoTuning; }
+    if (s == QLatin1String("AUTO"))        { return TunerMode::Auto; }
+    if (s == QLatin1String("false"))       { return TunerMode::Off; }
+    return TunerMode::Unknown;
+}
+
+TunerSetup tunerSetupFromString(const QString& s)
+{
+    if (s == QLatin1String("NOT TUNED")) { return TunerSetup::NotTuned; }
+    if (s == QLatin1String("BYPASS"))    { return TunerSetup::Bypass; }
+    if (s == QLatin1String("CL"))        { return TunerSetup::CL; }
+    if (s == QLatin1String("LC"))        { return TunerSetup::LC; }
+    return TunerSetup::Unknown;
+}
+
+}  // namespace
+
+// ── Parsers ──────────────────────────────────────────────────────────────
+
+std::optional<Info> parseInfo(const QByteArray& body)
+{
+    const auto obj = parseObject(body);
+    if (!obj) {
+        return std::nullopt;
+    }
+    const QJsonValue device = obj->value(QLatin1String("device"));
+    if (!device.isString()) {
+        return std::nullopt;
+    }
+    Info info;
+    info.device = device.toString();
+    info.customName = stringOr(obj->value(QLatin1String("custom_device_name")));
+    const QJsonValue sw = obj->value(QLatin1String("software_version"));
+    if (sw.isObject()) {
+        const QJsonObject s = sw.toObject();
+        asInt(s.value(QLatin1String("GUI")), info.guiVersion);
+        asInt(s.value(QLatin1String("controller")), info.controllerVersion);
+    }
+    return info;
+}
+
+std::optional<Power> parsePower(const QByteArray& body)
+{
+    const auto obj = parseObject(body);
+    if (!obj) {
+        return std::nullopt;
+    }
+    const auto temperature = parseFloatValue(obj->value(QLatin1String("temperature")));
+    const auto voltage = parseFloatValue(obj->value(QLatin1String("voltage")));
+    const auto current = parseFloatValue(obj->value(QLatin1String("current")));
+    const auto forward = parseIntWithMax(obj->value(QLatin1String("forward")));
+    const auto reflected = parseIntWithMax(obj->value(QLatin1String("reflected")));
+    const auto swr = parseFloatWithMax(obj->value(QLatin1String("swr")));
+    if (!temperature || !voltage || !current || !forward || !reflected || !swr) {
+        return std::nullopt;
+    }
+    Power power;
+    power.temperature = *temperature;
+    power.voltage = *voltage;
+    power.current = *current;
+    power.forward = *forward;
+    power.reflected = *reflected;
+    power.swr = *swr;
+    return power;
+}
+
+std::optional<Data> parseData(const QByteArray& body)
+{
+    const auto obj = parseObject(body);
+    if (!obj) {
+        return std::nullopt;
+    }
+    const auto band = parseIntValue(obj->value(QLatin1String("band")));
+    const auto frequency = parseIntValue(obj->value(QLatin1String("frequency")));
+    if (!band || !frequency) {
+        return std::nullopt;
+    }
+    Data data;
+    data.band = *band;
+    data.frequency = *frequency;
+    data.status = stringOr(obj->value(QLatin1String("status")));
+    return data;
+}
+
+std::optional<Tuner> parseTuner(const QByteArray& body)
+{
+    const auto obj = parseObject(body);
+    if (!obj || !obj->contains(QLatin1String("mode"))) {
+        return std::nullopt;
+    }
+    Tuner tuner;
+    tuner.mode = tunerModeFromValue(obj->value(QLatin1String("mode")));
+    tuner.setup = tunerSetupFromString(stringOr(obj->value(QLatin1String("setup"))));
+    tuner.l = parseIntValue(obj->value(QLatin1String("L")));
+    tuner.c = parseIntValue(obj->value(QLatin1String("C")));
+    tuner.tunedFrequency = parseIntValue(obj->value(QLatin1String("tuned_frequency")));
+    tuner.segmentSize = parseIntValue(obj->value(QLatin1String("segment_size")));
+    return tuner;
+}
+
+std::optional<OperateMode> parseOperateMode(const QByteArray& body)
+{
+    const auto obj = parseObject(body);
+    if (!obj) {
+        return std::nullopt;
+    }
+    const QString mode = obj->value(QLatin1String("operate_mode")).toString();
+    if (mode == QLatin1String("OPERATE")) {
+        return OperateMode::Operate;
+    }
+    if (mode == QLatin1String("STANDBY")) {
+        return OperateMode::Standby;
+    }
+    return std::nullopt;
+}
+
+std::optional<InterfaceState> parseInterface(const QByteArray& body)
+{
+    const auto obj = parseObject(body);
+    if (!obj) {
+        return std::nullopt;
+    }
+    const QString name = obj->value(QLatin1String("operational_interface")).toString();
+    InterfaceState state;
+    if (name == QLatin1String("UNIV")) {
+        state.active = OperationalInterface::Univ;
+    } else if (name == QLatin1String("CAT")) {
+        state.active = OperationalInterface::Cat;
+    } else if (name == QLatin1String("UDP")) {
+        state.active = OperationalInterface::Udp;
+    } else if (name == QLatin1String("TCI")) {
+        state.active = OperationalInterface::Tci;
+    } else {
+        return std::nullopt;
+    }
+    state.error = stringOr(obj->value(QLatin1String("error")));
+    return state;
+}
+
+std::optional<Antenna> parseAntenna(const QByteArray& body)
+{
+    const auto obj = parseObject(body);
+    if (!obj) {
+        return std::nullopt;
+    }
+    return antennaFromObject(*obj);
+}
+
+std::optional<QVector<AntennaWithState>> parseAntennas(const QByteArray& body)
+{
+    if (body.isEmpty() || body.size() > kMaxBodyBytes) {
+        return std::nullopt;
+    }
+    QJsonParseError error;
+    const QJsonDocument doc = QJsonDocument::fromJson(body, &error);
+    if (error.error != QJsonParseError::NoError || !doc.isArray()) {
+        return std::nullopt;
+    }
+    QVector<AntennaWithState> out;
+    for (const QJsonValue& entry : doc.array()) {
+        if (!entry.isObject()) {
+            continue;
+        }
+        const QJsonObject o = entry.toObject();
+        const auto antenna = antennaFromObject(o);
+        if (!antenna) {
+            continue;
+        }
+        const QString state = o.value(QLatin1String("state")).toString();
+        AntennaWithState item;
+        item.antenna = *antenna;
+        if (state == QLatin1String("ACTIVE")) {
+            item.state = AntennaState::Active;
+        } else if (state == QLatin1String("AVAILABLE")) {
+            item.state = AntennaState::Available;
+        } else if (state == QLatin1String("DISABLED")) {
+            item.state = AntennaState::Disabled;
+        } else {
+            continue;
+        }
+        out.append(item);
+    }
+    return out;
+}
+
+std::optional<ApiError> parseApiError(const QByteArray& body)
+{
+    const auto obj = parseObject(body);
+    if (!obj) {
+        return std::nullopt;
+    }
+    ApiError error;
+    error.status = stringOr(obj->value(QLatin1String("status")));
+    error.reason = stringOr(obj->value(QLatin1String("reason")));
+    return error;
+}
+
+// ── Request bodies ───────────────────────────────────────────────────────
+
+QByteArray buildOperateModeBody(OperateMode mode)
+{
+    QJsonObject o;
+    o.insert(QLatin1String("operate_mode"),
+             mode == OperateMode::Operate ? QStringLiteral("OPERATE") : QStringLiteral("STANDBY"));
+    return QJsonDocument(o).toJson(QJsonDocument::Compact);
+}
+
+QByteArray buildAntennaBody(const Antenna& antenna)
+{
+    if (!antennaInRange(antenna)) {
+        return {};
+    }
+    QJsonObject o;
+    o.insert(QLatin1String("type"),
+             antenna.type == AntennaType::Internal ? QStringLiteral("INTERNAL")
+                                                   : QStringLiteral("EXTERNAL"));
+    o.insert(QLatin1String("number"), antenna.number);
+    return QJsonDocument(o).toJson(QJsonDocument::Compact);
+}
+
+// ── Presentation helpers ─────────────────────────────────────────────────
+
+float temperatureCelsius(const FloatValue& temperature)
+{
+    // "°F", "F" and "degF" all contain an F and never a C; "°C" is the
+    // expected case and passes through unchanged.
+    const QString unit = temperature.unit.toUpper();
+    if (unit.contains(QLatin1Char('F')) && !unit.contains(QLatin1Char('C'))) {
+        return (temperature.value - 32.0f) * 5.0f / 9.0f;
+    }
+    return temperature.value;
+}
+
+QString formatFrequency(const IntValue& frequency)
+{
+    const QString unit = frequency.unit.trimmed().toLower();
+    double mhz = 0.0;
+    if (unit == QLatin1String("hz")) {
+        mhz = frequency.value / 1.0e6;
+    } else if (unit == QLatin1String("khz")) {
+        mhz = frequency.value / 1.0e3;
+    } else if (unit == QLatin1String("mhz")) {
+        mhz = frequency.value;
+    } else {
+        // An unrecognized unit is shown as given rather than mis-scaled.
+        return frequency.unit.isEmpty()
+            ? QString::number(frequency.value)
+            : QStringLiteral("%1 %2").arg(frequency.value).arg(frequency.unit);
+    }
+    return QStringLiteral("%1 MHz").arg(mhz, 0, 'f', 3);
+}
+
+QString formatBand(const IntValue& band)
+{
+    return band.unit.isEmpty()
+        ? QString::number(band.value)
+        : QStringLiteral("%1 %2").arg(band.value).arg(band.unit);
+}
+
+QString antennaLabel(const Antenna& antenna)
+{
+    return antenna.type == AntennaType::Internal
+        ? QString::number(antenna.number)
+        : QStringLiteral("E%1").arg(antenna.number);
+}
+
+QString tunerModeLabel(TunerMode mode)
+{
+    switch (mode) {
+    case TunerMode::Bypass:     return QStringLiteral("BYPASS");
+    case TunerMode::Manual:     return QStringLiteral("MANUAL");
+    case TunerMode::AutoTuning: return QStringLiteral("TUNING");
+    case TunerMode::Auto:       return QStringLiteral("AUTO");
+    case TunerMode::Off:        return QStringLiteral("OFF");
+    case TunerMode::Unknown:    break;
+    }
+    return QStringLiteral("—");
+}
+
+QString tunerSetupLabel(TunerSetup setup)
+{
+    switch (setup) {
+    case TunerSetup::NotTuned: return QStringLiteral("NOT TUNED");
+    case TunerSetup::Bypass:   return QStringLiteral("BYPASS");
+    case TunerSetup::CL:       return QStringLiteral("CL");
+    case TunerSetup::LC:       return QStringLiteral("LC");
+    case TunerSetup::Unknown:  break;
+    }
+    return QStringLiteral("—");
+}
+
+QString interfaceLabel(OperationalInterface iface)
+{
+    switch (iface) {
+    case OperationalInterface::Univ: return QStringLiteral("UNIV");
+    case OperationalInterface::Cat:  return QStringLiteral("CAT");
+    case OperationalInterface::Udp:  return QStringLiteral("UDP");
+    case OperationalInterface::Tci:  return QStringLiteral("TCI");
+    }
+    return QStringLiteral("—");
+}
+
+}  // namespace Rfkit
+}  // namespace AetherSDR
diff --git a/src/core/RfkitProtocol.h b/src/core/RfkitProtocol.h
new file mode 100644
index 0000000..e698d29
--- /dev/null
+++ b/src/core/RfkitProtocol.h
@@ -0,0 +1,226 @@
+#pragma once
+
+#include <optional>
+
+#include <QByteArray>
+#include <QMetaType>
+#include <QString>
+#include <QVector>
+
+namespace AetherSDR {
+
+// RF-KIT amplifier REST API codec.
+//
+// Protocol authority: the vendor's own published "RFKIT API and SDK
+// Documentation" (OpenAPI document, version 0.9.0), a public manufacturer
+// document, so this is a clean-room input under constitution Principle IV.
+// See docs/architecture/rfkit-amplifier-design.md for the design note.
+//
+// Unlike every other amplifier peripheral here the wire is plain HTTP/1.1
+// carrying JSON, not a socket protocol with its own framing, so this layer is
+// stateless: one parse function per endpoint (bytes in, optional struct out)
+// and one body builder per writable endpoint. RfkitConnection owns the
+// polling, the request queue and the HTTP plumbing.
+//
+//   GET  /info                   device identity + firmware versions
+//   GET  /power                  forward / reflected / SWR / temp / volts / amps
+//   GET  /data                   band, frequency, free-text status
+//   GET  /tuner                  tuner mode + L/C network (read-only)
+//   GET  /antennas               every antenna with ACTIVE/AVAILABLE/DISABLED
+//   GET  /antennas/active        the active antenna
+//   PUT  /antennas/active        select an antenna
+//   GET  /operate-mode           OPERATE | STANDBY
+//   PUT  /operate-mode           set OPERATE | STANDBY
+//   GET  /operational-interface  UNIV | CAT | UDP | TCI (+ read-only error)
+//   POST /error/reset            clear the amplifier's error state
+//
+// Everything parsed here arrives from a LAN peer, so constitution Principle
+// VII applies: bodies are size-capped, a document that is not the expected
+// JSON shape yields nullopt rather than a half-filled struct, and a
+// control-state enum (operate mode, operational interface, antenna type)
+// that this codec cannot interpret is refused rather than guessed. Fields the
+// document marks descriptive only (units, max_value, tuner L/C) default
+// quietly when absent, so a firmware that omits one does not blank the applet.
+namespace Rfkit {
+
+// The API document's examples use port 8080 (http://localhost:8080/...). The
+// Peripherals row exposes it as an editable field.
+inline constexpr quint16 kDefaultPort = 8080;
+
+// No endpoint answers with more than a few hundred bytes. A peer that sends
+// more is not an RF-KIT, so the body is dropped rather than parsed.
+inline constexpr int kMaxBodyBytes = 64 * 1024;
+
+inline constexpr int kMinInternalAntenna = 1;
+inline constexpr int kMaxInternalAntenna = 4;
+inline constexpr int kMinExternalAntenna = 1;
+inline constexpr int kMaxExternalAntenna = 16;
+
+// Endpoint paths, relative to the device root.
+inline constexpr char kPathInfo[]        = "/info";
+inline constexpr char kPathPower[]       = "/power";
+inline constexpr char kPathData[]        = "/data";
+inline constexpr char kPathTuner[]       = "/tuner";
+inline constexpr char kPathAntennas[]    = "/antennas";
+inline constexpr char kPathAntennaActive[] = "/antennas/active";
+inline constexpr char kPathOperateMode[] = "/operate-mode";
+inline constexpr char kPathInterface[]   = "/operational-interface";
+inline constexpr char kPathErrorReset[]  = "/error/reset";
+
+// ── Value types ──────────────────────────────────────────────────────────
+// The API wraps every measurement as {value, unit[, max_value]}. The unit is
+// carried through so the applet shows what the device said instead of
+// assuming one.
+
+struct IntValue {
+    int value{0};
+    QString unit;
+};
+
+struct FloatValue {
+    float value{0.0f};
+    QString unit;
+};
+
+// maxValue is the device's own full-scale for the reading and is what the
+// applet sizes its gauge to. 0 means "not reported".
+struct IntWithMax {
+    int value{0};
+    int maxValue{0};
+    QString unit;
+};
+
+struct FloatWithMax {
+    float value{0.0f};
+    float maxValue{0.0f};
+    QString unit;
+};
+
+// ── Responses ────────────────────────────────────────────────────────────
+
+struct Info {
+    QString device;
+    QString customName;  // the operator-assigned name; may be empty
+    int guiVersion{0};
+    int controllerVersion{0};
+};
+
+struct Power {
+    FloatValue temperature;
+    FloatValue voltage;
+    FloatValue current;
+    IntWithMax forward;
+    IntWithMax reflected;
+    FloatWithMax swr;
+};
+
+struct Data {
+    IntValue band;
+    IntValue frequency;
+    QString status;  // free text; the API document does not enumerate it
+};
+
+enum class TunerMode { Unknown, Bypass, Manual, AutoTuning, Auto, Off };
+enum class TunerSetup { Unknown, NotTuned, Bypass, CL, LC };
+
+struct Tuner {
+    TunerMode mode{TunerMode::Unknown};
+    TunerSetup setup{TunerSetup::Unknown};
+    std::optional<IntValue> l;
+    std::optional<IntValue> c;
+    std::optional<IntValue> tunedFrequency;
+    std::optional<IntValue> segmentSize;
+};
+
+enum class OperateMode { Standby, Operate };
+
+enum class OperationalInterface { Univ, Cat, Udp, Tci };
+
+struct InterfaceState {
+    // Not named "interface": that is a macro in the Windows SDK headers.
+    OperationalInterface active{OperationalInterface::Univ};
+    QString error;  // read-only; empty when the device reported none
+};
+
+enum class AntennaType { Internal, External };
+
+struct Antenna {
+    AntennaType type{AntennaType::Internal};
+    int number{1};
+
+    bool operator==(const Antenna& other) const
+    {
+        return type == other.type && number == other.number;
+    }
+};
+
+enum class AntennaState { Active, Available, Disabled };
+
+struct AntennaWithState {
+    Antenna antenna;
+    AntennaState state{AntennaState::Available};
+};
+
+// The device's error body, sent with a 400 or 409: {"status":..,"reason":..}.
+struct ApiError {
+    QString status;
+    QString reason;
+};
+
+// One snapshot of everything the connection has learned. An unset optional
+// means "the device has not answered that endpoint yet", which is not the
+// same as a reading of zero, and the applet renders it as "—".
+struct Status {
+    std::optional<Info> info;
+    std::optional<Power> power;
+    std::optional<Data> data;
+    std::optional<Tuner> tuner;
+    std::optional<OperateMode> operate;
+    std::optional<InterfaceState> interfaceState;
+    std::optional<QVector<AntennaWithState>> antennas;
+};
+
+// ── Parsers ──────────────────────────────────────────────────────────────
+// Each takes the raw HTTP body. nullopt means the body was oversized, not
+// JSON, not the expected shape, or carried a control value this codec cannot
+// interpret.
+
+std::optional<Info> parseInfo(const QByteArray& body);
+std::optional<Power> parsePower(const QByteArray& body);
+std::optional<Data> parseData(const QByteArray& body);
+std::optional<Tuner> parseTuner(const QByteArray& body);
+std::optional<OperateMode> parseOperateMode(const QByteArray& body);
+std::optional<InterfaceState> parseInterface(const QByteArray& body);
+std::optional<Antenna> parseAntenna(const QByteArray& body);
+// The /antennas array. Entries that are malformed are skipped; the call fails
+// only if the document is not an array at all.
+std::optional<QVector<AntennaWithState>> parseAntennas(const QByteArray& body);
+std::optional<ApiError> parseApiError(const QByteArray& body);
+
+// ── Request bodies ───────────────────────────────────────────────────────
+// Compact JSON. buildAntennaBody returns an empty array for an antenna number
+// outside the range the API document allows for its type, so an out-of-range
+// request never reaches the wire.
+
+QByteArray buildOperateModeBody(OperateMode mode);
+QByteArray buildAntennaBody(const Antenna& antenna);
+
+// ── Presentation helpers ─────────────────────────────────────────────────
+
+// Temperature in degrees Celsius, converting when the device reports °F.
+float temperatureCelsius(const FloatValue& temperature);
+// "14.200 MHz" from a frequency in Hz, kHz or MHz; "<value> <unit>" for any
+// other unit, so an unexpected unit is shown rather than mis-scaled.
+QString formatFrequency(const IntValue& frequency);
+// "20 m": the value and the unit the device gave it.
+QString formatBand(const IntValue& band);
+// "1".."4" for the internal antennas, "E1".."E16" for the external ones.
+QString antennaLabel(const Antenna& antenna);
+QString tunerModeLabel(TunerMode mode);
+QString tunerSetupLabel(TunerSetup setup);
+QString interfaceLabel(OperationalInterface iface);
+
+}  // namespace Rfkit
+}  // namespace AetherSDR
+
+Q_DECLARE_METATYPE(AetherSDR::Rfkit::Status)
