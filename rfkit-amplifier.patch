@@ -0,0 +1,97 @@
+#pragma once
+
+#include "core/RfkitProtocol.h"
+
+#include <QPushButton>
+#include <QTimer>
+#include <QVector>
+#include <QWidget>
+
+class QComboBox;
+class QLabel;
+
+namespace AetherSDR {
+
+class HGauge;
+
+// Dedicated applet for an RF-KIT amplifier — a sibling of AmpApplet (PGXL),
+// AcomApplet, SpeApplet, VkampApplet and Kpa1500Applet, not a variant of any
+// of them. See docs/architecture/rfkit-amplifier-design.md.
+//
+// The device's REST API exposes the tuner read-only (there is no tune
+// command), so the tuner appears here as a status line, not as controls. What
+// the API does let the operator change — operate/standby, the active antenna,
+// and clearing an error — are the controls below. The operational interface
+// (UNIV/CAT/UDP/TCI) is shown but deliberately not switchable from here:
+// changing it can silently cut the amplifier off from the radio that is
+// driving it.
+class RfkitApplet : public QWidget {
+    Q_OBJECT
+
+public:
+    explicit RfkitApplet(QWidget* parent = nullptr);
+
+    // One call per status snapshot — the applet reads the fields it shows.
+    // Unset optionals render as "—", never as 0: the device answers each
+    // endpoint independently, so "not reported yet" and "reported as zero" are
+    // genuinely different states here.
+    void setStatus(const Rfkit::Status& status);
+    void setConnected(bool connected);
+
+signals:
+    void operateToggled(bool operate);
+    void antennaSelected(const AetherSDR::Rfkit::Antenna& antenna);
+    void errorResetRequested();
+
+private:
+    void updateValueLabels();
+    void refreshControls();
+    void refreshAntennas();
+    void updateGaugeScale();
+
+    HGauge* m_pwrGauge{nullptr};
+    HGauge* m_refGauge{nullptr};
+    HGauge* m_swrGauge{nullptr};
+
+    QLabel* m_pwrLabel{nullptr};
+    QLabel* m_refLabel{nullptr};
+    QLabel* m_swrLabel{nullptr};
+
+    QLabel* m_nameLabel{nullptr};
+    QLabel* m_statusPill{nullptr};
+    QLabel* m_tempLabel{nullptr};
+    QLabel* m_voltsLabel{nullptr};
+    QLabel* m_currentLabel{nullptr};
+    QLabel* m_bandLabel{nullptr};
+    QLabel* m_freqLabel{nullptr};
+    QLabel* m_ifaceLabel{nullptr};
+    QLabel* m_tunerLabel{nullptr};
+    QLabel* m_deviceStatusLabel{nullptr};
+    QLabel* m_faultLabel{nullptr};
+
+    QPushButton* m_operateBtn{nullptr};
+    QPushButton* m_resetErrorBtn{nullptr};
+    // One button per internal antenna (the API allows 1-4); the external
+    // antennas (up to 16) are a combo box, since 16 buttons do not fit a
+    // docked applet.
+    QVector<QPushButton*> m_antBtns;
+    QComboBox* m_extAntCombo{nullptr};
+
+    QTimer m_labelTimer;
+
+    Rfkit::Status m_status;
+    bool m_connected{false};
+
+    // The gauge scales currently applied, so setStatus() only rebuilds a
+    // gauge's range when the device-reported full scale actually changes.
+    int m_gaugeFwdMax{0};
+    int m_gaugeRefMax{0};
+
+    // setStatus() arrives at the connection's poll rate — funneled through
+    // the m_labelTimer tick, the same throttle convention the other amplifier
+    // applets use, rather than repainting and re-announcing accessibility text
+    // on every reply.
+    bool m_valuesDirty{false};
+};
+
+}  // namespace AetherSDR
diff --git a/tests/rfkit_connection_test.cpp b/tests/rfkit_connection_test.cpp
new file mode 100644
index 0000000..fe8e0ba
--- /dev/null
+++ b/tests/rfkit_connection_test.cpp
@@ -0,0 +1,440 @@
+// Transport-level behaviour of RfkitConnection, against a stub RF-KIT speaking
+// HTTP/1.1 on loopback. RfkitProtocol has its own pure-codec test; this covers
+// what only exists once there is a live HTTP exchange underneath: the connect
+// handshake (GET /info), strictly serialized requests, command bodies and
+// verbs, refusal of out-of-range antennas before the wire, a non-RF-KIT peer,
+// an invalid address, and loss of the link after repeated transport failures.
+
+#include "TestSettingsProfile.h"
+
+#include "core/RfkitConnection.h"
+#include "core/RfkitProtocol.h"
+
+#include <QCoreApplication>
+#include <QDeadlineTimer>
+#include <QHostAddress>
+#include <QMap>
+#include <QPointer>
+#include <QSignalSpy>
+#include <QTcpServer>
+#include <QTcpSocket>
+#include <QTimer>
+
+#include <algorithm>
+#include <cstdio>
+#include <functional>
+
+using namespace AetherSDR;
+
+namespace {
+
+int g_failed = 0;
+
+void report(const char* name, bool ok)
+{
+    std::printf("%s %s\n", ok ? "[ OK ]" : "[FAIL]", name);
+    if (!ok) {
+        ++g_failed;
+    }
+}
+
+bool spin(std::function<bool()> done, int timeoutMs = 5000)
+{
+    QDeadlineTimer deadline(timeoutMs);
+    while (!done() && !deadline.hasExpired()) {
+        QCoreApplication::processEvents(QEventLoop::AllEvents, 20);
+    }
+    return done();
+}
+
+void spinFor(int ms)
+{
+    QDeadlineTimer deadline(ms);
+    while (!deadline.hasExpired()) {
+        QCoreApplication::processEvents(QEventLoop::AllEvents, 20);
+    }
+}
+
+// A stub RF-KIT. Answers "METHOD /path" from a route table, records every
+// request, and tracks how many were outstanding at once (a reply is delayed so
+// that overlap, if the client produced any, is observable).
+class StubAmp : public QObject {
+public:
+    struct Reply {
+        int status{200};
+        QByteArray body;
+    };
+
+    StubAmp()
+    {
+        m_server.listen(QHostAddress::LocalHost, 0);
+        QObject::connect(&m_server, &QTcpServer::newConnection, this, [this]() {
+            while (QTcpSocket* socket = m_server.nextPendingConnection()) {
+                m_sockets.append(socket);
+                QObject::connect(socket, &QTcpSocket::readyRead, this, [this, socket]() { onReadyRead(socket); });
+            }
+        });
+        resetRoutes();
+    }
+
+    bool listening() const { return m_server.isListening(); }
+    quint16 port() const { return m_server.serverPort(); }
+    void stopListening()
+    {
+        m_server.close();
+        for (QTcpSocket* s : m_sockets) {
+            if (s) { s->abort(); }
+        }
+    }
+
+    void resetRoutes()
+    {
+        routes.clear();
+        routes["GET /info"] = {200, R"({"device":"RFKIT","software_version":{"GUI":1,"controller":2},"custom_device_name":"Test"})"};
+        routes["GET /power"] = {200,
+            R"({"temperature":{"value":40,"unit":"C"},"voltage":{"value":50,"unit":"V"},)"
+            R"("current":{"value":10,"unit":"A"},"forward":{"value":800,"max_value":1500,"unit":"W"},)"
+            R"("reflected":{"value":20,"max_value":300,"unit":"W"},"swr":{"value":1.3,"max_value":10,"unit":""}})"};
+        routes["GET /data"] = {200, R"({"band":{"value":20,"unit":"m"},"frequency":{"value":14200,"unit":"kHz"},"status":"OK"})"};
+        routes["GET /tuner"] = {200, R"({"mode":"AUTO","setup":"CL"})"};
+        routes["GET /operate-mode"] = {200, R"({"operate_mode":"STANDBY"})"};
+        routes["GET /operational-interface"] = {200, R"({"operational_interface":"CAT"})"};
+        routes["GET /antennas"] = {200,
+            R"([{"type":"INTERNAL","number":1,"state":"ACTIVE"},{"type":"INTERNAL","number":2,"state":"AVAILABLE"}])"};
+        routes["PUT /operate-mode"] = {200, R"({"operate_mode":"OPERATE"})"};
+        routes["PUT /antennas/active"] = {200, R"({"type":"INTERNAL","number":2})"};
+        routes["POST /error/reset"] = {200, "{}"};
+    }
+
+    int count(const QString& key) const
+    {
+        int n = 0;
+        for (const QString& r : requests) { if (r == key) { ++n; } }
+        return n;
+    }
+
+    QMap<QString, Reply> routes;
+    QStringList requests;           // "METHOD /path" in arrival order
+    QMap<QString, QByteArray> bodies;  // last body per "METHOD /path"
+    int maxOutstanding{0};
+    int replyDelayMs{15};
+
+private:
+    void onReadyRead(QTcpSocket* socket)
+    {
+        QByteArray& buf = m_buffers[socket];
+        buf += socket->readAll();
+        for (;;) {
+            const int headerEnd = buf.indexOf("\r\n\r\n");
+            if (headerEnd < 0) { return; }
+            const QByteArray head = buf.left(headerEnd);
+            int contentLength = 0;
+            for (const QByteArray& line : head.split('\n')) {
+                if (line.toLower().startsWith("content-length:")) {
+                    contentLength = line.mid(15).trimmed().toInt();
+                }
+            }
+            if (buf.size() < headerEnd + 4 + contentLength) { return; }
+            const QByteArray body = buf.mid(headerEnd + 4, contentLength);
+            buf.remove(0, headerEnd + 4 + contentLength);
+
+            const QList<QByteArray> first = head.left(head.indexOf('\r')).split(' ');
+            const QString key = QString::fromLatin1(first.value(0) + ' ' + first.value(1));
+            requests.append(key);
+            bodies[key] = body;
+            ++m_outstanding;
+            maxOutstanding = std::max(maxOutstanding, m_outstanding);
+
+            const Reply reply = routes.value(key, Reply{404, R"({"status":"error","reason":"no such endpoint"})"});
+            const QPointer<QTcpSocket> guard(socket);
+            QTimer::singleShot(replyDelayMs, this, [this, guard, reply]() {
+                --m_outstanding;
+                if (!guard) { return; }
+                QByteArray out = "HTTP/1.1 " + QByteArray::number(reply.status) + " X\r\n"
+                    "Content-Type: application/json\r\nContent-Length: "
+                    + QByteArray::number(reply.body.size()) + "\r\n\r\n" + reply.body;
+                guard->write(out);
+            });
+        }
+    }
+
+    QTcpServer m_server;
+    QList<QPointer<QTcpSocket>> m_sockets;
+    QMap<QTcpSocket*, QByteArray> m_buffers;
+    int m_outstanding{0};
+};
+
+}  // namespace
+
+int main(int argc, char** argv)
+{
+    // Before QCoreApplication and before anything can touch AppSettings --
+    // LogManager reaches for it on the first qCWarning. Per the CMake settings
+    // contract in AGENTS.md.
+    TestSettingsProfile profile(QStringLiteral("rfkit-connection-test"));
+
+    QCoreApplication app(argc, argv);
+
+    // Fail fast rather than burn the timeout when loopback cannot be bound
+    // (SKIP_RETURN_CODE 77 in tests.cmake).
+    {
+        StubAmp probe;
+        if (!probe.listening()) {
+            std::printf("[SKIP] cannot bind a loopback TCP port\n");
+            return 77;
+        }
+    }
+
+    // ── Handshake, initial refresh, polling, serialization ────────────────
+    {
+        StubAmp amp;
+        RfkitConnection conn;
+        QSignalSpy connectedSpy(&conn, &RfkitConnection::connected);
+        QSignalSpy statusSpy(&conn, &RfkitConnection::statusUpdated);
+
+        conn.connectNetwork(QStringLiteral("127.0.0.1"), amp.port());
+        report("connects once GET /info returns an RF-KIT document",
+               spin([&] { return connectedSpy.count() > 0; }) && conn.isConnected());
+        report("the first request is the GET /info handshake",
+               !amp.requests.isEmpty() && amp.requests.first() == "GET /info");
+        report("description() names the target", conn.description() == QString("127.0.0.1:%1").arg(amp.port()));
+
+        report("the initial refresh fills the snapshot",
+               spin([&] {
+                   if (statusSpy.isEmpty()) { return false; }
+                   const auto s = statusSpy.last().at(0).value<Rfkit::Status>();
+                   return s.info && s.power && s.data && s.tuner && s.operate && s.interfaceState && s.antennas;
+               }));
+        if (!statusSpy.isEmpty()) {
+            const auto s = statusSpy.last().at(0).value<Rfkit::Status>();
+            report("the snapshot carries decoded values",
+                   s.info && s.info->customName == "Test" && s.power && s.power->forward.value == 800
+                       && s.operate && *s.operate == Rfkit::OperateMode::Standby
+                       && s.antennas && s.antennas->size() == 2);
+        }
+
+        report("polling continues after the initial refresh",
+               spin([&] { return amp.count("GET /power") >= 4; }));
+        report("the slow endpoints are polled too",
+               spin([&] { return amp.count("GET /tuner") >= 2 && amp.count("GET /antennas") >= 2; }));
+        report("requests are strictly serialized: never two outstanding at once",
+               amp.maxOutstanding == 1);
+        conn.disconnect();
+    }
+
+    // ── Commands: verb, path, body ─────────────────────────────────────────
+    {
+        StubAmp amp;
+        RfkitConnection conn;
+        QSignalSpy connectedSpy(&conn, &RfkitConnection::connected);
+        QSignalSpy statusSpy(&conn, &RfkitConnection::statusUpdated);
+        conn.connectNetwork(QStringLiteral("127.0.0.1"), amp.port());
+        spin([&] { return connectedSpy.count() > 0; });
+        spinFor(300);
+
+        conn.setOperate(true);
+        report("setOperate(true) sends PUT /operate-mode",
+               spin([&] { return amp.count("PUT /operate-mode") == 1; }));
+        report("the OPERATE body is exact",
+               amp.bodies.value("PUT /operate-mode") == QByteArray(R"({"operate_mode":"OPERATE"})"));
+        report("the reply to the PUT updates the snapshot",
+               spin([&] {
+                   const auto s = statusSpy.last().at(0).value<Rfkit::Status>();
+                   return s.operate && *s.operate == Rfkit::OperateMode::Operate;
+               }));
+
+        conn.setOperate(false);
+        spin([&] { return amp.count("PUT /operate-mode") == 2; });
+        report("the STANDBY body is exact",
+               amp.bodies.value("PUT /operate-mode") == QByteArray(R"({"operate_mode":"STANDBY"})"));
+
+        const int antennaReads = amp.count("GET /antennas");
+        conn.selectAntenna({Rfkit::AntennaType::Internal, 2});
+        report("selectAntenna sends PUT /antennas/active",
+               spin([&] { return amp.count("PUT /antennas/active") == 1; }));
+        report("the antenna body is exact",
+               amp.bodies.value("PUT /antennas/active") == QByteArray(R"({"type":"INTERNAL","number":2})"));
+        report("an antenna change re-reads the antenna list",
+               spin([&] { return amp.count("GET /antennas") > antennaReads; }));
+
+        // Out of range: refused before the wire.
+        conn.selectAntenna({Rfkit::AntennaType::Internal, 9});
+        conn.selectAntenna({Rfkit::AntennaType::External, 0});
+        spinFor(300);
+        report("out-of-range antennas never reach the wire",
+               amp.count("PUT /antennas/active") == 1);
+
+        conn.resetError();
+        report("resetError sends POST /error/reset",
+               spin([&] { return amp.count("POST /error/reset") == 1; }));
+        const int dataReads = amp.count("GET /data");
+        report("resetting an error re-reads state it can have changed",
+               spin([&] { return amp.count("GET /data") > dataReads; }));
+
+        report("every command still honored serialization", amp.maxOutstanding == 1);
+        conn.disconnect();
+    }
+
+    // ── A refused command (409) does not drop the link ────────────────────
+    {
+        StubAmp amp;
+        amp.routes["PUT /operate-mode"] = {409, R"({"status":"error","reason":"Function currently disabled"})"};
+        RfkitConnection conn;
+        QSignalSpy connectedSpy(&conn, &RfkitConnection::connected);
+        QSignalSpy disconnectedSpy(&conn, &RfkitConnection::disconnected);
+        conn.connectNetwork(QStringLiteral("127.0.0.1"), amp.port());
+        spin([&] { return connectedSpy.count() > 0; });
+        spinFor(200);
+
+        conn.setOperate(true);
+        spin([&] { return amp.count("PUT /operate-mode") == 1; });
+        spinFor(500);
+        report("a 409 on a command is logged and the link stays up",
+               conn.isConnected() && disconnectedSpy.isEmpty());
+        report("polling continues after a refused command", amp.count("GET /power") >= 2);
+        conn.disconnect();
+    }
+
+    // ── A peer that is not an RF-KIT ───────────────────────────────────────
+    {
+        StubAmp amp;
+        amp.routes["GET /info"] = {404, "not found"};
+        RfkitConnection conn;
+        QSignalSpy connectedSpy(&conn, &RfkitConnection::connected);
+        QSignalSpy failedSpy(&conn, &RfkitConnection::connectionFailed);
+        conn.connectNetwork(QStringLiteral("127.0.0.1"), amp.port());
+        report("a 404 on the handshake fails the connection",
+               spin([&] { return failedSpy.count() > 0; }) && connectedSpy.isEmpty() && !conn.isConnected());
+        report("no poll traffic follows a failed handshake", amp.count("GET /power") == 0);
+    }
+    {
+        StubAmp amp;
+        amp.routes["GET /info"] = {200, "<html>router login</html>"};
+        RfkitConnection conn;
+        QSignalSpy connectedSpy(&conn, &RfkitConnection::connected);
+        QSignalSpy failedSpy(&conn, &RfkitConnection::connectionFailed);
+        conn.connectNetwork(QStringLiteral("127.0.0.1"), amp.port());
+        report("a 200 that is not an RF-KIT document fails the connection",
+               spin([&] { return failedSpy.count() > 0; }) && connectedSpy.isEmpty() && !conn.isConnected());
+    }
+    {
+        // Principle VII: a peer that streams more than any endpoint can send.
+        StubAmp amp;
+        amp.routes["GET /info"] = {200, QByteArray(Rfkit::kMaxBodyBytes * 3, 'x')};
+        RfkitConnection conn;
+        QSignalSpy connectedSpy(&conn, &RfkitConnection::connected);
+        QSignalSpy failedSpy(&conn, &RfkitConnection::connectionFailed);
+        conn.connectNetwork(QStringLiteral("127.0.0.1"), amp.port());
+        report("an oversized response fails the connection",
+               spin([&] { return failedSpy.count() > 0; }) && connectedSpy.isEmpty());
+    }
+
+    // ── Invalid or unreachable addresses ───────────────────────────────────
+    {
+        RfkitConnection conn;
+        QSignalSpy failedSpy(&conn, &RfkitConnection::connectionFailed);
+        conn.connectNetwork(QString(), 8080);
+        report("an empty address is refused immediately", failedSpy.count() == 1 && !conn.isConnected());
+        conn.connectNetwork(QStringLiteral("host/with/slashes"), 8080);
+        report("an address that is not a bare host is refused", failedSpy.count() == 2);
+        conn.connectNetwork(QStringLiteral("user@host"), 8080);
+        report("an address with userinfo is refused", failedSpy.count() == 3);
+        conn.connectNetwork(QStringLiteral("127.0.0.1"), 0);
+        report("port 0 is refused", failedSpy.count() == 4);
+    }
+    {
+        // Nothing listening: a refused connection reports failure, not a hang.
+        quint16 closedPort = 0;
+        {
+            QTcpServer probe;
+            probe.listen(QHostAddress::LocalHost, 0);
+            closedPort = probe.serverPort();
+        }
+        RfkitConnection conn;
+        QSignalSpy failedSpy(&conn, &RfkitConnection::connectionFailed);
+        conn.connectNetwork(QStringLiteral("127.0.0.1"), closedPort);
+        report("a connection refused is reported as a failure",
+               spin([&] { return failedSpy.count() > 0; }) && !conn.isConnected());
+    }
+
+    // ── Loss of the link ────────────────────────────────────────────────────
+    {
+        StubAmp amp;
+        RfkitConnection conn;
+        QSignalSpy connectedSpy(&conn, &RfkitConnection::connected);
+        QSignalSpy disconnectedSpy(&conn, &RfkitConnection::disconnected);
+        conn.connectNetwork(QStringLiteral("127.0.0.1"), amp.port());
+        spin([&] { return connectedSpy.count() > 0; });
+        spinFor(300);
+
+        amp.stopListening();
+        report("repeated transport failures take the link down (disconnected emitted once)",
+               spin([&] { return disconnectedSpy.count() > 0; }, 8000));
+        spinFor(300);
+        report("disconnected is emitted exactly once", disconnectedSpy.count() == 1 && !conn.isConnected());
+    }
+
+    // ── HTTP error statuses are not transport failures ─────────────────────
+    {
+        StubAmp amp;
+        RfkitConnection conn;
+        conn.setAutoReconnect(true);
+        QSignalSpy connectedSpy(&conn, &RfkitConnection::connected);
+        QSignalSpy disconnectedSpy(&conn, &RfkitConnection::disconnected);
+        conn.connectNetwork(QStringLiteral("127.0.0.1"), amp.port());
+        spin([&] { return connectedSpy.count() > 0; });
+        // The device answers every poll with a 500. It is reachable and
+        // talking HTTP, so the link must not be declared down.
+        amp.routes["GET /power"] = {500, "{}"};
+        spinFor(800);
+        report("HTTP error statuses are not transport failures: the link stays up",
+               conn.isConnected() && disconnectedSpy.isEmpty());
+        conn.disconnect();
+    }
+
+    // ── Deliberate disconnect ───────────────────────────────────────────────
+    {
+        StubAmp amp;
+        RfkitConnection conn;
+        conn.setAutoReconnect(true);
+        QSignalSpy connectedSpy(&conn, &RfkitConnection::connected);
+        QSignalSpy disconnectedSpy(&conn, &RfkitConnection::disconnected);
+        conn.connectNetwork(QStringLiteral("127.0.0.1"), amp.port());
+        spin([&] { return connectedSpy.count() > 0; });
+
+        conn.disconnect();
+        report("disconnect() emits disconnected() itself", disconnectedSpy.count() == 1);
+        report("the connection reports itself down", !conn.isConnected());
+
+        const int before = amp.requests.size();
+        conn.setOperate(true);
+        conn.resetError();
+        conn.selectAntenna({Rfkit::AntennaType::Internal, 1});
+        spinFor(500);
+        report("commands after a disconnect are dropped, not queued", amp.requests.size() == before);
+        report("a deliberate disconnect does not auto-reconnect", connectedSpy.count() == 1 && !conn.isConnected());
+    }
+
+    // ── Reconnecting over a live link ───────────────────────────────────────
+    {
+        StubAmp first;
+        StubAmp second;
+        RfkitConnection conn;
+        QSignalSpy connectedSpy(&conn, &RfkitConnection::connected);
+        QSignalSpy disconnectedSpy(&conn, &RfkitConnection::disconnected);
+        conn.connectNetwork(QStringLiteral("127.0.0.1"), first.port());
+        spin([&] { return connectedSpy.count() > 0; });
+        conn.connectNetwork(QStringLiteral("127.0.0.1"), second.port());
+        report("connecting to a new target tears down the old session first",
+               disconnectedSpy.count() == 1);
+        report("and the new session comes up",
+               spin([&] { return connectedSpy.count() == 2; }) && conn.isConnected());
+        const int firstBefore = first.requests.size();
+        spinFor(500);
+        report("the old target is no longer polled", first.requests.size() == firstBefore);
+        conn.disconnect();
+    }
+
+    std::printf("\n%d RF-KIT connection test(s) failed.\n", g_failed);
+    return g_failed == 0 ? 0 : 1;
+}
diff --git a/tests/rfkit_protocol_test.cpp b/tests/rfkit_protocol_test.cpp
new file mode 100644
index 0000000..0b0614a
--- /dev/null
+++ b/tests/rfkit_protocol_test.cpp
@@ -0,0 +1,268 @@
+// Pure-codec tests for the RF-KIT REST/JSON protocol layer.
+//
+// Two things matter here:
+//
+//  1. The documents are asserted against the shapes in the vendor's "RFKIT API
+//     and SDK Documentation" (OpenAPI 0.9.0), not against this codec's own
+//     output (constitution Principle I/IV).
+//
+//  2. These bytes come straight off a LAN peer (Principle VII): oversized
+//     bodies, non-JSON, wrong shapes, out-of-range antennas and control enums
+//     the codec cannot interpret must all yield nullopt rather than a
+//     half-filled struct, and the request builders must refuse out-of-range
+//     antennas so they never reach the wire.
+
+#include "core/RfkitProtocol.h"
+
+#include <QByteArray>
+#include <QJsonDocument>
+#include <QJsonObject>
+
+#include <cmath>
+#include <cstdio>
+
+using namespace AetherSDR::Rfkit;
+
+namespace {
+
+int g_failed = 0;
+
+void report(const char* name, bool ok)
+{
+    std::printf("%s %s\n", ok ? "[ OK ]" : "[FAIL]", name);
+    if (!ok) {
+        ++g_failed;
+    }
+}
+
+bool nearlyEqual(float a, float b, float tolerance = 0.001f)
+{
+    return std::fabs(a - b) <= tolerance;
+}
+
+const QByteArray kPowerJson =
+    R"({"temperature":{"value":41.5,"unit":"°C"},"voltage":{"value":50.2,"unit":"V"},)"
+    R"("current":{"value":12.3,"unit":"A"},"forward":{"value":1200,"max_value":1500,"unit":"W"},)"
+    R"("reflected":{"value":30,"max_value":300,"unit":"W"},)"
+    R"("swr":{"value":1.4,"max_value":10.0,"unit":""}})";
+
+}  // namespace
+
+int main()
+{
+    // ── /power ────────────────────────────────────────────────────────────
+    {
+        const auto p = parsePower(kPowerJson);
+        report("parsePower decodes a well-formed document", p.has_value());
+        if (p) {
+            report("forward watts and the device's own full scale",
+                   p->forward.value == 1200 && p->forward.maxValue == 1500 && p->forward.unit == "W");
+            report("reflected watts and full scale", p->reflected.value == 30 && p->reflected.maxValue == 300);
+            report("swr is a float", nearlyEqual(p->swr.value, 1.4f) && nearlyEqual(p->swr.maxValue, 10.0f));
+            report("temperature/voltage/current decode",
+                   nearlyEqual(p->temperature.value, 41.5f) && nearlyEqual(p->voltage.value, 50.2f)
+                       && nearlyEqual(p->current.value, 12.3f));
+            report("units are carried through", p->current.unit == "A" && p->voltage.unit == "V");
+        }
+    }
+    {
+        // max_value is descriptive: absent means "not reported" (0), not a failure.
+        const auto p = parsePower(
+            R"({"temperature":{"value":30,"unit":"C"},"voltage":{"value":50,"unit":"V"},)"
+            R"("current":{"value":1,"unit":"A"},"forward":{"value":0,"unit":"W"},)"
+            R"("reflected":{"value":0,"unit":"W"},"swr":{"value":1.0,"unit":""}})");
+        report("a missing max_value decodes as 0 (not reported)",
+               p.has_value() && p->forward.maxValue == 0 && p->reflected.maxValue == 0);
+    }
+    report("parsePower rejects a document missing a required block",
+           !parsePower(R"({"forward":{"value":1,"max_value":2,"unit":"W"}})").has_value());
+    report("parsePower rejects a non-numeric value",
+           !parsePower(
+               R"({"temperature":{"value":"hot","unit":"C"},"voltage":{"value":1,"unit":"V"},)"
+               R"("current":{"value":1,"unit":"A"},"forward":{"value":1,"unit":"W"},)"
+               R"("reflected":{"value":1,"unit":"W"},"swr":{"value":1,"unit":""}})").has_value());
+    report("parsePower rejects non-JSON", !parsePower("<html>not an api</html>").has_value());
+    report("parsePower rejects an empty body", !parsePower(QByteArray()).has_value());
+    report("parsePower rejects a JSON array", !parsePower("[1,2,3]").has_value());
+    {
+        // Principle VII: a body larger than any endpoint can legitimately send
+        // is dropped without parsing.
+        QByteArray huge = kPowerJson;
+        huge.append(QByteArray(kMaxBodyBytes, ' '));
+        report("an oversized body is rejected", !parsePower(huge).has_value());
+    }
+
+    // ── /data ─────────────────────────────────────────────────────────────
+    {
+        const auto d = parseData(
+            R"({"band":{"value":20,"unit":"m"},"frequency":{"value":14200,"unit":"kHz"},"status":"OK"})");
+        report("parseData decodes band, frequency and status",
+               d.has_value() && d->band.value == 20 && d->band.unit == "m"
+                   && d->frequency.value == 14200 && d->status == "OK");
+    }
+    report("parseData rejects a document without a frequency",
+           !parseData(R"({"band":{"value":20,"unit":"m"},"status":"OK"})").has_value());
+
+    // ── /info ─────────────────────────────────────────────────────────────
+    {
+        const auto i = parseInfo(
+            R"({"device":"RFKIT","software_version":{"GUI":12,"controller":34},"custom_device_name":"Shack amp"})");
+        report("parseInfo decodes identity and versions",
+               i.has_value() && i->device == "RFKIT" && i->customName == "Shack amp"
+                   && i->guiVersion == 12 && i->controllerVersion == 34);
+    }
+    report("parseInfo rejects a document with no device name",
+           !parseInfo(R"({"software_version":{"GUI":1,"controller":2}})").has_value());
+
+    // ── /tuner ────────────────────────────────────────────────────────────
+    {
+        const auto t = parseTuner(
+            R"({"mode":"AUTO","setup":"CL","L":{"value":12,"unit":"nH"},"C":{"value":340,"unit":"pF"},)"
+            R"("tuned_frequency":{"value":14200,"unit":"kHz"},"segment_size":{"value":50,"unit":"kHz"}})");
+        report("parseTuner decodes mode, setup and the L/C network",
+               t.has_value() && t->mode == TunerMode::Auto && t->setup == TunerSetup::CL
+                   && t->l && t->l->value == 12 && t->c && t->c->value == 340);
+    }
+    {
+        const auto t = parseTuner(R"({"mode":"BYPASS"})");
+        report("parseTuner needs only mode; the rest is optional",
+               t.has_value() && t->mode == TunerMode::Bypass && t->setup == TunerSetup::Unknown
+                   && !t->l && !t->c);
+    }
+    {
+        // The OpenAPI enum lists the literal false beside the names.
+        const auto asBool = parseTuner(R"({"mode":false})");
+        const auto asString = parseTuner(R"({"mode":"false"})");
+        report("the document's literal false decodes as tuner OFF (boolean and string)",
+               asBool && asBool->mode == TunerMode::Off && asString && asString->mode == TunerMode::Off);
+    }
+    report("an unknown tuner mode is Unknown rather than a rejection",
+           parseTuner(R"({"mode":"WARP"})")->mode == TunerMode::Unknown);
+    report("parseTuner rejects a document with no mode", !parseTuner(R"({"setup":"CL"})").has_value());
+
+    // ── /operate-mode ─────────────────────────────────────────────────────
+    report("OPERATE decodes", parseOperateMode(R"({"operate_mode":"OPERATE"})") == OperateMode::Operate);
+    report("STANDBY decodes", parseOperateMode(R"({"operate_mode":"STANDBY"})") == OperateMode::Standby);
+    // A control state this codec cannot interpret is refused, never guessed.
+    report("an unknown operate mode is rejected, not guessed to a default",
+           !parseOperateMode(R"({"operate_mode":"BOOST"})").has_value());
+    report("a lower-case operate mode is rejected (the enum is exact)",
+           !parseOperateMode(R"({"operate_mode":"operate"})").has_value());
+    report("a missing operate_mode is rejected", !parseOperateMode("{}").has_value());
+
+    // ── /operational-interface ────────────────────────────────────────────
+    {
+        const auto s = parseInterface(R"({"operational_interface":"TCI","error":"link lost"})");
+        report("parseInterface decodes the interface and the read-only error",
+               s.has_value() && s->active == OperationalInterface::Tci && s->error == "link lost");
+    }
+    report("all four interfaces decode",
+           parseInterface(R"({"operational_interface":"UNIV"})")->active == OperationalInterface::Univ
+               && parseInterface(R"({"operational_interface":"CAT"})")->active == OperationalInterface::Cat
+               && parseInterface(R"({"operational_interface":"UDP"})")->active == OperationalInterface::Udp);
+    report("an unknown interface is rejected",
+           !parseInterface(R"({"operational_interface":"RS232"})").has_value());
+
+    // ── Antennas ──────────────────────────────────────────────────────────
+    {
+        const auto a = parseAntenna(R"({"type":"INTERNAL","number":3})");
+        report("an internal antenna decodes",
+               a.has_value() && a->type == AntennaType::Internal && a->number == 3);
+    }
+    {
+        const auto a = parseAntenna(R"({"type":"EXTERNAL","number":16})");
+        report("external antenna 16 (the maximum) decodes",
+               a.has_value() && a->type == AntennaType::External && a->number == 16);
+    }
+    report("internal antenna 5 is out of range (the API allows 1-4)",
+           !parseAntenna(R"({"type":"INTERNAL","number":5})").has_value());
+    report("internal antenna 0 is out of range",
+           !parseAntenna(R"({"type":"INTERNAL","number":0})").has_value());
+    report("external antenna 17 is out of range (the API allows 1-16)",
+           !parseAntenna(R"({"type":"EXTERNAL","number":17})").has_value());
+    report("an unknown antenna type is rejected",
+           !parseAntenna(R"({"type":"MAGIC","number":1})").has_value());
+    report("a non-integer antenna number is rejected",
+           !parseAntenna(R"({"type":"INTERNAL","number":"one"})").has_value());
+    {
+        const auto list = parseAntennas(
+            R"([{"type":"INTERNAL","number":1,"state":"ACTIVE"},)"
+            R"({"type":"INTERNAL","number":2,"state":"AVAILABLE"},)"
+            R"({"type":"EXTERNAL","number":3,"state":"DISABLED"}])");
+        report("parseAntennas decodes the list with states",
+               list.has_value() && list->size() == 3
+                   && list->at(0).state == AntennaState::Active
+                   && list->at(1).state == AntennaState::Available
+                   && list->at(2).state == AntennaState::Disabled
+                   && list->at(2).antenna.type == AntennaType::External);
+    }
+    {
+        // One bad entry costs only itself.
+        const auto list = parseAntennas(
+            R"([{"type":"INTERNAL","number":9,"state":"ACTIVE"},)"
+            R"({"type":"INTERNAL","number":2,"state":"WARM"},)"
+            R"(7,{"type":"INTERNAL","number":4,"state":"AVAILABLE"}])");
+        report("malformed antenna entries are skipped, valid ones survive",
+               list.has_value() && list->size() == 1 && list->at(0).antenna.number == 4);
+    }
+    report("an antenna list that is not an array is rejected",
+           !parseAntennas(R"({"type":"INTERNAL","number":1,"state":"ACTIVE"})").has_value());
+    report("an empty antenna array is a valid, empty list",
+           parseAntennas("[]").has_value() && parseAntennas("[]")->isEmpty());
+
+    // ── Error body ────────────────────────────────────────────────────────
+    {
+        const auto e = parseApiError(R"({"status":"error","reason":"Function currently disabled"})");
+        report("parseApiError decodes status and reason",
+               e.has_value() && e->status == "error" && e->reason == "Function currently disabled");
+    }
+    report("parseApiError rejects non-JSON", !parseApiError("Conflict").has_value());
+
+    // ── Request builders ──────────────────────────────────────────────────
+    {
+        const QJsonObject o = QJsonDocument::fromJson(buildOperateModeBody(OperateMode::Operate)).object();
+        report("OPERATE body", o.value("operate_mode").toString() == "OPERATE" && o.size() == 1);
+        const QJsonObject s = QJsonDocument::fromJson(buildOperateModeBody(OperateMode::Standby)).object();
+        report("STANDBY body", s.value("operate_mode").toString() == "STANDBY");
+    }
+    {
+        const QJsonObject o = QJsonDocument::fromJson(
+            buildAntennaBody({AntennaType::External, 12})).object();
+        report("external antenna body",
+               o.value("type").toString() == "EXTERNAL" && o.value("number").toInt() == 12);
+    }
+    {
+        const QJsonObject o = QJsonDocument::fromJson(
+            buildAntennaBody({AntennaType::Internal, 4})).object();
+        report("internal antenna body",
+               o.value("type").toString() == "INTERNAL" && o.value("number").toInt() == 4);
+    }
+    report("an out-of-range internal antenna is never built",
+           buildAntennaBody({AntennaType::Internal, 5}).isEmpty()
+               && buildAntennaBody({AntennaType::Internal, 0}).isEmpty());
+    report("an out-of-range external antenna is never built",
+           buildAntennaBody({AntennaType::External, 17}).isEmpty()
+               && buildAntennaBody({AntennaType::External, -1}).isEmpty());
+    {
+        // A built body must round-trip through the parser the device's reply uses.
+        const auto round = parseAntenna(buildAntennaBody({AntennaType::External, 7}));
+        report("a built antenna body parses back to the same antenna",
+               round.has_value() && *round == Antenna{AntennaType::External, 7});
+    }
+
+    // ── Presentation helpers ──────────────────────────────────────────────
+    report("temperature in °C passes through", nearlyEqual(temperatureCelsius({40.0f, "°C"}), 40.0f));
+    report("temperature in °F is converted", nearlyEqual(temperatureCelsius({104.0f, "°F"}), 40.0f));
+    report("frequency in kHz formats as MHz", formatFrequency({14200, "kHz"}) == "14.200 MHz");
+    report("frequency in Hz formats as MHz", formatFrequency({7074000, "Hz"}) == "7.074 MHz");
+    report("frequency in MHz formats as MHz", formatFrequency({28, "MHz"}) == "28.000 MHz");
+    report("an unrecognized frequency unit is shown as given, not mis-scaled",
+           formatFrequency({14200, "furlongs"}) == "14200 furlongs");
+    report("band is value plus unit", formatBand({20, "m"}) == "20 m");
+    report("band with no unit is just the value", formatBand({20, ""}) == "20");
+    report("internal antenna label", antennaLabel({AntennaType::Internal, 2}) == "2");
+    report("external antenna label", antennaLabel({AntennaType::External, 11}) == "E11");
+
+    std::printf("\n%d RF-KIT protocol test(s) failed.\n", g_failed);
+    return g_failed == 0 ? 0 : 1;
+}
