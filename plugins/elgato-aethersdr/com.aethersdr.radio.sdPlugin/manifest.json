{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "UUID": "com.aethersdr.radio",
  "Version": "1.0.3.0",
  "Name": "AetherSDR",
  "Description": "Full AetherSDR radio control via TCI — actions across FlexRadio TX, bands, modes, DSP, audio and DVK, with selectable slice targeting.",
  "Author": "AetherSDR",
  "URL": "https://github.com/aethersdr/AetherSDR",
  "Icon": "imgs/plugin-icon",
  "CodePath": "plugin.js",
  "Category": "AetherSDR",
  "CategoryIcon": "imgs/plugin-icon",
  "SDKVersion": 2,
  "Software": {
    "MinimumVersion": "6.4"
  },
  "OS": [
    { "Platform": "mac", "MinimumVersion": "13" },
    { "Platform": "windows", "MinimumVersion": "10" }
  ],
  "Nodejs": {
    "Version": "20",
    "Debug": "enabled"
  },
  "Actions": [
    { "UUID": "com.aethersdr.radio.tci-status", "Name": "TCI Connection Status", "Category": "Status", "Icon": "imgs/plugin-icon", "Tooltip": "Shows whether the plugin is connected to AetherSDR's TCI server", "Controllers": ["Keypad"], "States": [{ "Image": "imgs/plugin-icon", "Title": "TCI" }] },
    { "UUID": "com.aethersdr.radio.ptt", "Name": "PTT (Push-to-Talk)", "Category": "TX", "Icon": "imgs/plugin-icon", "Tooltip": "Hold to transmit", "Controllers": ["Keypad"], "States": [{ "Image": "imgs/plugin-icon", "Title": "PTT" }] },
    { "UUID": "com.aethersdr.radio.mox-toggle", "Name": "MOX Toggle", "Category": "TX", "Icon": "imgs/plugin-icon", "Tooltip": "Toggle transmit on/off", "Controllers": ["Keypad"], "States": [{ "Image": "imgs/plugin-icon", "Title": "MOX" }] },
    { "UUID": "com.aethersdr.radio.tune-toggle", "Name": "TUNE Toggle", "Category": "TX", "Icon": "imgs/plugin-icon", "Tooltip": "Toggle tune carrier", "Controllers": ["Keypad"], "States": [{ "Image": "imgs/plugin-icon", "Title": "TUNE" }] },
    { "UUID": "com.aethersdr.radio.rf-power", "Name": "RF Power", "Category": "TX", "Icon": "imgs/plugin-icon", "Tooltip": "Cycle RF power level", "Controllers": ["Keypad"], "States": [{ "Image": "imgs/plugin-icon", "Title": "RF PWR" }] },
    { "UUID": "com.aethersdr.radio.tune-power", "Name": "Tune Power", "Category": "TX", "Icon": "imgs/plugin-icon", "Tooltip": "Cycle tune power", "Controllers": ["Keypad"], "States": [{ "Image": "imgs/plugin-icon", "Title": "TUNE PWR" }] },
    { "UUID": "com.aethersdr.radio.slice-target", "Name": "Slice Target", "Category": "Slice", "Icon": "imgs/plugin-icon", "Tooltip": "Cycle which slice the slice actions control: TRX0, the TX slice, or the active (GUI-focused) slice", "Controllers": ["Keypad"], "States": [{ "Image": "imgs/plugin-icon", "Title": "Slice" }] },
    { "UUID": "com.aethersdr.radio.split-toggle", "Name": "Split Toggle", "Category": "Slice", "Icon": "imgs/plugin-icon", "Controllers": ["Keypad"], "States": [{ "Image": "imgs/plugin-icon", "Title": "SPLIT" }] },
    { "UUID": "com.aethersdr.radio.lock-toggle", "Name": "Lock Toggle", "Category": "Slice", "Icon": "imgs/plugin-icon", "Controllers": ["Keypad"], "States": [{ "Image": "imgs/plugin-icon", "Title": "LOCK" }] },
    { "UUID": "com.aethersdr.radio.rit-toggle", "Name": "RIT Toggle", "Category": "Slice", "Icon": "imgs/plugin-icon", "Controllers": ["Keypad"], "States": [{ "Image": "imgs/plugin-icon", "Title": "RIT" }] },
    { "UUID": "com.aethersdr.radio.xit-toggle", "Name": "XIT Toggle", "Category": "Slice", "Icon": "imgs/plugin-icon", "Controllers": ["Keypad"], "States": [{ "Image": "imgs/plugin-icon", "Title": "XIT" }] },
    { "UUID": "com.aethersdr.radio.band-160m", "Name": "Band 160m", "Category": "Frequency", "Icon": "imgs/plugin-icon", "Controllers": ["Keypad"], "States": [{ "Image": "imgs/plugin-icon", "Title": "160m" }] },
    { "UUID": "com.aethersdr.radio.band-80m", "Name": "Band 80m", "Category": "Frequency", "Icon": "imgs/plugin-icon", "Controllers": ["Keypad"], "States": [{ "Image": "imgs/plugin-icon", "Title": "80m" }] },
    { "UUID": "com.aethersdr.radio.band-60m", "Name": "Band 60m", "Category": "Frequency", "Icon": "imgs/plugin-icon", "Controllers": ["Keypad"], "States": [{ "Image": "imgs/plugin-icon", "Title": "60m" }] },
    { "UUID": "com.aethersdr.radio.band-40m", "Name": "Band 40m", "Category": "Frequency", "Icon": "imgs/plugin-icon", "Controllers": ["Keypad"], "States": [{ "Image": "imgs/plugin-icon", "Title": "40m" }] },
    { "UUID": "com.aethersdr.radio.band-30m", "Name": "Band 30m", "Category": "Frequency", "Icon": "imgs/plugin-icon", "Controllers": ["Keypad"], "States": [{ "Image": "imgs/plugin-icon", "Title": "30m" }] },
    { "UUID": "com.aethersdr.radio.band-20m", "Name": "Band 20m", "Category": "Frequency", "Icon": "imgs/plugin-icon", "Controllers": ["Keypad"], "States": [{ "Image": "imgs/plugin-icon", "Title": "20m" }] },
    { "UUID": "com.aethersdr.radio.band-17m", "Name": "Band 17m", "Category": "Frequency", "Icon": "imgs/plugin-icon", "Controllers": ["Keypad"], "States": [{ "Image": "imgs/plugin-icon", "Title": "17m" }] },
    { "UUID": "com.aethersdr.radio.band-15m", "Name": "Band 15m", "Category": "Frequency", "Icon": "imgs/plugin-icon", "Controllers": ["Keypad"], "States": [{ "Image": "imgs/plugin-icon", "Title": "15m" }] },
    { "UUID": "com.aethersdr.radio.band-12m", "Name": "Band 12m", "Category": "Frequency", "Icon": "imgs/plugin-icon", "Controllers": ["Keypad"], "States": [{ "Image": "imgs/plugin-icon", "Title": "12m" }] },
    { "UUID": "com.aethersdr.radio.band-10m", "Name": "Band 10m", "Category": "Frequency", "Icon": "imgs/plugin-icon", "Controllers": ["Keypad"], "States": [{ "Image": "imgs/plugin-icon", "Title": "10m" }] },
    { "UUID": "com.aethersdr.radio.band-6m", "Name": "Band 6m", "Category": "Frequency", "Icon": "imgs/plugin-icon", "Controllers": ["Keypad"], "States": [{ "Image": "imgs/plugin-icon", "Title": "6m" }] },
    { "UUID": "com.aethersdr.radio.band-up", "Name": "Band Up", "Category": "Frequency", "Icon": "imgs/plugin-icon", "Controllers": ["Keypad"], "States": [{ "Image": "imgs/plugin-icon", "Title": "Band Up" }] },
    { "UUID": "com.aethersdr.radio.band-down", "Name": "Band Down", "Category": "Frequency", "Icon": "imgs/plugin-icon", "Controllers": ["Keypad"], "States": [{ "Image": "imgs/plugin-icon", "Title": "Band Down" }] },
    { "UUID": "com.aethersdr.radio.tune-up", "Name": "Tune Up", "Category": "Frequency", "Icon": "imgs/plugin-icon", "Controllers": ["Keypad"], "States": [{ "Image": "imgs/plugin-icon", "Title": "Tune Up" }] },
    { "UUID": "com.aethersdr.radio.tune-down", "Name": "Tune Down", "Category": "Frequency", "Icon": "imgs/plugin-icon", "Controllers": ["Keypad"], "States": [{ "Image": "imgs/plugin-icon", "Title": "Tune Down" }] },
    { "UUID": "com.aethersdr.radio.mode-usb", "Name": "Mode USB", "Category": "Modes", "Icon": "imgs/plugin-icon", "Controllers": ["Keypad"], "States": [{ "Image": "imgs/plugin-icon", "Title": "USB" }] },
    { "UUID": "com.aethersdr.radio.mode-lsb", "Name": "Mode LSB", "Category": "Modes", "Icon": "imgs/plugin-icon", "Controllers": ["Keypad"], "States": [{ "Image": "imgs/plugin-icon", "Title": "LSB" }] },
    { "UUID": "com.aethersdr.radio.mode-cw", "Name": "Mode CW", "Category": "Modes", "Icon": "imgs/plugin-icon", "Controllers": ["Keypad"], "States": [{ "Image": "imgs/plugin-icon", "Title": "CW" }] },
    { "UUID": "com.aethersdr.radio.mode-cwr", "Name": "Mode CWR", "Category": "Modes", "Icon": "imgs/plugin-icon", "Tooltip": "Set mode to CW reverse (CWL)", "Controllers": ["Keypad"], "States": [{ "Image": "imgs/plugin-icon", "Title": "CWR" }] },
    { "UUID": "com.aethersdr.radio.mode-am", "Name": "Mode AM", "Category": "Modes", "Icon": "imgs/plugin-icon", "Controllers": ["Keypad"], "States": [{ "Image": "imgs/plugin-icon", "Title": "AM" }] },
    { "UUID": "com.aethersdr.radio.mode-sam", "Name": "Mode SAM", "Category": "Modes", "Icon": "imgs/plugin-icon", "Tooltip": "Set mode to synchronous AM", "Controllers": ["Keypad"], "States": [{ "Image": "imgs/plugin-icon", "Title": "SAM" }] },
    { "UUID": "com.aethersdr.radio.mode-fm", "Name": "Mode FM", "Category": "Modes", "Icon": "imgs/plugin-icon", "Controllers": ["Keypad"], "States": [{ "Image": "imgs/plugin-icon", "Title": "FM" }] },
    { "UUID": "com.aethersdr.radio.mode-nfm", "Name": "Mode NFM", "Category": "Modes", "Icon": "imgs/plugin-icon", "Tooltip": "Set mode to narrow FM", "Controllers": ["Keypad"], "States": [{ "Image": "imgs/plugin-icon", "Title": "NFM" }] },
    { "UUID": "com.aethersdr.radio.mode-digu", "Name": "Mode DIGU", "Category": "Modes", "Icon": "imgs/plugin-icon", "Controllers": ["Keypad"], "States": [{ "Image": "imgs/plugin-icon", "Title": "DIGU" }] },
    { "UUID": "com.aethersdr.radio.mode-digl", "Name": "Mode DIGL", "Category": "Modes", "Icon": "imgs/plugin-icon", "Controllers": ["Keypad"], "States": [{ "Image": "imgs/plugin-icon", "Title": "DIGL" }] },
    { "UUID": "com.aethersdr.radio.mode-rtty", "Name": "Mode RTTY", "Category": "Modes", "Icon": "imgs/plugin-icon", "Tooltip": "Set mode to RTTY", "Controllers": ["Keypad"], "States": [{ "Image": "imgs/plugin-icon", "Title": "RTTY" }] },
    { "UUID": "com.aethersdr.radio.mute-all", "Name": "Mute All Audio", "Category": "Audio", "Icon": "imgs/plugin-icon", "Tooltip": "Toggle master volume between silence and its previous level", "Controllers": ["Keypad"], "States": [{ "Image": "imgs/plugin-icon", "Title": "MUTE\nALL" }] },
    { "UUID": "com.aethersdr.radio.mute-toggle", "Name": "Mute Toggle", "Category": "Audio", "Icon": "imgs/plugin-icon", "Controllers": ["Keypad"], "States": [{ "Image": "imgs/plugin-icon", "Title": "MUTE" }] },
    { "UUID": "com.aethersdr.radio.volume-up", "Name": "Volume Up", "Category": "Audio", "Icon": "imgs/plugin-icon", "Controllers": ["Keypad"], "States": [{ "Image": "imgs/plugin-icon", "Title": "Vol Up" }] },
    { "UUID": "com.aethersdr.radio.volume-down", "Name": "Volume Down", "Category": "Audio", "Icon": "imgs/plugin-icon", "Controllers": ["Keypad"], "States": [{ "Image": "imgs/plugin-icon", "Title": "Vol Down" }] },
    { "UUID": "com.aethersdr.radio.slice-volume-up", "Name": "Slice Volume Up", "Category": "Audio", "Icon": "imgs/plugin-icon", "Tooltip": "Raise the targeted slice's own audio level", "Controllers": ["Keypad"], "States": [{ "Image": "imgs/plugin-icon", "Title": "SLICE VOL+" }] },
    { "UUID": "com.aethersdr.radio.slice-volume-down", "Name": "Slice Volume Down", "Category": "Audio", "Icon": "imgs/plugin-icon", "Tooltip": "Lower the targeted slice's own audio level", "Controllers": ["Keypad"], "States": [{ "Image": "imgs/plugin-icon", "Title": "SLICE VOL-" }] },
    { "UUID": "com.aethersdr.radio.nb-toggle", "Name": "NB Toggle", "Category": "DSP", "Icon": "imgs/plugin-icon", "Controllers": ["Keypad"], "States": [{ "Image": "imgs/plugin-icon", "Title": "NB" }] },
    { "UUID": "com.aethersdr.radio.nr-toggle", "Name": "NR Toggle", "Category": "DSP", "Icon": "imgs/plugin-icon", "Controllers": ["Keypad"], "States": [{ "Image": "imgs/plugin-icon", "Title": "NR" }] },
    { "UUID": "com.aethersdr.radio.anf-toggle", "Name": "ANF Toggle", "Category": "DSP", "Icon": "imgs/plugin-icon", "Controllers": ["Keypad"], "States": [{ "Image": "imgs/plugin-icon", "Title": "ANF" }] },
    { "UUID": "com.aethersdr.radio.apf-toggle", "Name": "APF Toggle", "Category": "DSP", "Icon": "imgs/plugin-icon", "Controllers": ["Keypad"], "States": [{ "Image": "imgs/plugin-icon", "Title": "APF" }] },
    { "UUID": "com.aethersdr.radio.sql-toggle", "Name": "Squelch Toggle", "Category": "DSP", "Icon": "imgs/plugin-icon", "Controllers": ["Keypad"], "States": [{ "Image": "imgs/plugin-icon", "Title": "SQL" }] },
    { "UUID": "com.aethersdr.radio.dvk-play", "Name": "DVK Play", "Category": "DVK", "Icon": "imgs/plugin-icon", "Controllers": ["Keypad"], "States": [{ "Image": "imgs/plugin-icon", "Title": "PLAY" }] },
    { "UUID": "com.aethersdr.radio.dvk-record", "Name": "DVK Record", "Category": "DVK", "Icon": "imgs/plugin-icon", "Controllers": ["Keypad"], "States": [{ "Image": "imgs/plugin-icon", "Title": "REC" }] },
    {
      "UUID": "com.aethersdr.radio.vfo-tune",
      "Name": "VFO Tuning",
      "Category": "Dials",
      "Icon": "imgs/plugin-icon",
      "Tooltip": "Turn to tune the VFO; press to change step size",
      "Controllers": ["Encoder"],
      "States": [{ "Image": "imgs/plugin-icon", "Title": "VFO" }],
      "Encoder": {
        "layout": "$A1",
        "TriggerDescription": {
          "Rotate": "Tune VFO frequency",
          "Push": "Cycle tuning step (10Hz-1MHz)"
        }
      }
    },
    {
      "UUID": "com.aethersdr.radio.rf-power-dial",
      "Name": "RF Power Dial",
      "Category": "Dials",
      "Icon": "imgs/plugin-icon",
      "Tooltip": "Turn to adjust RF power; press to change step size",
      "Controllers": ["Encoder"],
      "States": [{ "Image": "imgs/plugin-icon", "Title": "RF Power" }],
      "Encoder": {
        "layout": "$A1",
        "TriggerDescription": {
          "Rotate": "Adjust RF power",
          "Push": "Cycle step size (1W/5W)"
        }
      }
    },
    {
      "UUID": "com.aethersdr.radio.tune-power-dial",
      "Name": "Tune Power Dial",
      "Category": "Dials",
      "Icon": "imgs/plugin-icon",
      "Tooltip": "Turn to adjust tune carrier power; press to change step size",
      "Controllers": ["Encoder"],
      "States": [{ "Image": "imgs/plugin-icon", "Title": "Tune Pwr" }],
      "Encoder": {
        "layout": "$A1",
        "TriggerDescription": {
          "Rotate": "Adjust tune carrier power",
          "Push": "Cycle step size (1W/5W)"
        }
      }
    },
    {
      "UUID": "com.aethersdr.radio.volume-dial",
      "Name": "Volume Dial",
      "Category": "Dials",
      "Icon": "imgs/plugin-icon",
      "Tooltip": "Turn to adjust volume; press to toggle mute",
      "Controllers": ["Encoder"],
      "States": [{ "Image": "imgs/plugin-icon", "Title": "Volume" }],
      "Encoder": {
        "layout": "$A1",
        "TriggerDescription": {
          "Rotate": "Adjust volume",
          "Push": "Toggle mute"
        }
      }
    }
  ]
}
